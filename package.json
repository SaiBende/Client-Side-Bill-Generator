{
  "name": "sharemybill",
  "private": true,
  "version": "1.0.0",
  "description": "ShareMyBill — free Indian business invoice generator with offline desktop app. Made by Sai Bende.",
  "author": "Sai Bende <https://github.com/saibende>",
  "homepage": "https://github.com/saibende",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"npm:dev\" \"node electron/start-dev.mjs\"",
    "desktop:start": "npm run build && npx electron .",
    "desktop:exe": "npm run build && electron-packager . ShareMyBill --platform=win32 --arch=x64 --out=release --overwrite",
    "desktop:dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.sharemybill.app",
    "productName": "ShareMyBill",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/sql.js/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
